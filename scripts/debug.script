local plinko_manager = require "scripts.plinko_manager"

local DRAW_DEBUG_TEXT = hash("draw_debug_text")
local REGISTER_SLOT = hash("register_slot")
local TEXT_COLOR = vmath.vector4(1, 1, 1, 1)
local PERCENTAGE_COLOR = vmath.vector4(0, 0, 0, 1)
local SCORE_OFFSET = vmath.vector3(-110, -30, 0)
local SLOT_COUNT_OFFSET = vmath.vector3(-3, 8, 0)
local SLOT_PERCENTAGE_OFFSET = vmath.vector3(-14, -10, 0)

local function draw_text(text, position, color)
	msg.post("@render:", DRAW_DEBUG_TEXT, {
		text = text,
		position = position,
		color = color,
	})
end

local function get_score_position(self)
	local background_size = go.get(self.background_sprite, "size")
	local local_top_right = vmath.vector4(background_size.x * 0.5, background_size.y * 0.5, 0, 1)
	local world_top_right = go.get_world_transform(self.background) * local_top_right
	local screen_top_right = camera.world_to_screen(
		vmath.vector3(world_top_right.x, world_top_right.y, world_top_right.z),
		self.camera
	)
	screen_top_right.z = 0
	return screen_top_right + SCORE_OFFSET
end

local function get_slot_screen_position(self, slot)
	local position = camera.world_to_screen(go.get_world_position(slot.game_object), self.camera)
	position.z = 0
	return position
end

local function draw_slot_statistics(self)
	local total_balls_count = 0
	for _, slot in pairs(self.slots) do
		slot.balls_count = math.max(0, math.floor(go.get(slot.script, "balls_count")))
		total_balls_count = total_balls_count + slot.balls_count
	end

	for _, slot in pairs(self.slots) do
		local percentage = 0
		if total_balls_count > 0 then
			percentage = slot.balls_count / total_balls_count * 100
		end

		local position = get_slot_screen_position(self, slot)
		draw_text(tostring(slot.balls_count), position + SLOT_COUNT_OFFSET, TEXT_COLOR)
		draw_text(string.format("%.1f%%", percentage), position + SLOT_PERCENTAGE_OFFSET, PERCENTAGE_COLOR)
	end
end

function init(self)
	self.slots = self.slots or {}
	self.background = msg.url("/background")
	self.background_sprite = msg.url("/background#sprite")
	self.camera = msg.url("/camera#camera")
end

function on_message(self, message_id, message, sender)
	if message_id == REGISTER_SLOT then
		self.slots = self.slots or {}
		self.slots[message.slot_index] = {
			game_object = msg.url(nil, message.slot_id, nil),
			script = msg.url(nil, message.slot_id, "script"),
		}
	end
end

function update(self, dt)
	local text = "Score: " .. tostring(plinko_manager.get_score())
	draw_text(text, get_score_position(self), TEXT_COLOR)
	draw_slot_statistics(self)
end
