local board_layout = require "scripts.board_layout"
local game_messages = require "scripts.game_messages"

local BOARD_SPAWNER = "/board_spawner"
local DRAW_DEBUG_TEXT = hash("draw_debug_text")
local TEXT_COLOR = vmath.vector4(1, 1, 1, 1)
local PERCENTAGE_COLOR = vmath.vector4(0, 0, 0, 1)
local SCORE_OFFSET = vmath.vector3(-110, -30, 0)
local SLOT_COUNT_OFFSET = vmath.vector3(-3, 8, 0)
local SLOT_PERCENTAGE_OFFSET = vmath.vector3(-14, -10, 0)

local function draw_text(text, position, color)
	msg.post("@render:", DRAW_DEBUG_TEXT, {
		text = text,
		position = position,
		color = color,
	})
end

local function world_to_screen(self, world_position)
	local view = go.get(self.camera, "view")
	local projection = go.get(self.camera, "projection")
	local clip_position = projection * view * vmath.vector4(
		world_position.x,
		world_position.y,
		world_position.z,
		1
	)
	local window_width, window_height = window.get_size()
	local inverse_w = 1 / clip_position.w

	return vmath.vector3(
		(clip_position.x * inverse_w + 1) * window_width * 0.5,
		(clip_position.y * inverse_w + 1) * window_height * 0.5,
		0
	)
end

local function get_score_position(self)
	local background_size = go.get(self.background_sprite, "size")
	local local_top_right = vmath.vector4(background_size.x * 0.5, background_size.y * 0.5, 0, 1)
	local world_top_right = go.get_world_transform(self.background) * local_top_right
	local screen_top_right = world_to_screen(
		self,
		vmath.vector3(world_top_right.x, world_top_right.y, world_top_right.z)
	)
	return screen_top_right + SCORE_OFFSET
end

local function draw_slot_statistics(self)
	local total_landing_count = self.game_state.total_landing_count

	for slot_index = 1, board_layout.get_slot_count() do
		local landing_count = self.game_state.landings_by_slot[slot_index] or 0
		local percentage = 0
		if total_landing_count > 0 then
			percentage = landing_count / total_landing_count * 100
		end

		local world_position = board_layout.get_slot_position(self.board_origin, slot_index)
		local screen_position = world_to_screen(self, world_position)
		draw_text(tostring(landing_count), screen_position + SLOT_COUNT_OFFSET, TEXT_COLOR)
		draw_text(string.format("%.1f%%", percentage), screen_position + SLOT_PERCENTAGE_OFFSET, PERCENTAGE_COLOR)
	end
end

function init(self)
	self.game_state = {
		score = 0,
		landings_by_slot = {},
		total_landing_count = 0,
	}
	self.background = msg.url("/background")
	self.background_sprite = msg.url("/background#sprite")
	self.board_origin = go.get_world_position(BOARD_SPAWNER)
	self.camera = msg.url("/camera#camera")
	msg.post(game_messages.GAME_CONTROLLER, game_messages.SUBSCRIBE_GAME_STATE)
end

function final(self)
	msg.post(game_messages.GAME_CONTROLLER, game_messages.UNSUBSCRIBE_GAME_STATE)
end

function on_message(self, message_id, message, sender)
	if message_id == game_messages.GAME_STATE_CHANGED then
		self.game_state = message
	end
end

function update(self, dt)
	draw_text("Score: " .. tostring(self.game_state.score), get_score_position(self), TEXT_COLOR)
	draw_slot_statistics(self)
end
