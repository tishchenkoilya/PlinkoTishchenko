local config = require "scripts.config"
local plinko_manager = require "scripts.plinko_manager"

local TOUCH = hash("touch")
local SPAWN_BALL = hash("spawn_ball")

local function format_time(seconds)
	seconds = math.max(0, math.ceil(seconds))
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor(seconds % 3600 / 60)
	local remaining_seconds = seconds % 60
	return string.format("%02d:%02d:%02d", hours, minutes, remaining_seconds)
end

local function update_status(self)
	gui.set_text(self.balls_count_text, tostring(plinko_manager.get_balls_count()))
	gui.set_text(self.timer_text, format_time(plinko_manager.get_seconds_until_next_ball()))
end

local function try_spawn_balls(self, count)
	if not plinko_manager.try_spend_balls(count) then
		return
	end

	msg.post("/hole#spawner", SPAWN_BALL, { count = count })
	update_status(self)
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.button_x1 = gui.get_node("button_x1")
	self.button_xn = gui.get_node("button_xn")
	self.button_xn_text = gui.get_node("text1")
	self.balls_count_text = gui.get_node("vlaue")
	self.timer_text = gui.get_node("timer")

	plinko_manager.reset()
	gui.set_text(self.button_xn_text, "x" .. tostring(config.params.multiple_balls_count))
	update_status(self)
end

function update(self, dt)
	plinko_manager.update(dt)
	update_status(self)
end

function on_input(self, action_id, action)
	if action_id == TOUCH and action.pressed then
		if gui.pick_node(self.button_x1, action.x, action.y) then
			try_spawn_balls(self, 1)
		elseif gui.pick_node(self.button_xn, action.x, action.y) then
			try_spawn_balls(self, config.params.multiple_balls_count)
		end
	end
end
