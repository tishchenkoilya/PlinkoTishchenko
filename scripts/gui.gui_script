local config = require "scripts.config"
local druid = require "druid.druid"
local game_messages = require "scripts.game_messages"

local BUTTON_NORMAL = hash("btn_green_normal")
local BUTTON_PUSH = hash("btn_green_push")

local function format_time(seconds)
	seconds = math.max(0, math.ceil(seconds))
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor(seconds % 3600 / 60)
	local remaining_seconds = seconds % 60
	return string.format("%02d:%02d:%02d", hours, minutes, remaining_seconds)
end

local function update_status(self, state)
	self.balls_count_text:set_text(state.balls_count)
	self.timer_text:set_text(format_time(state.seconds_until_next_ball))
end

local function try_spawn_balls(self, count)
	msg.post(game_messages.GAME_CONTROLLER, game_messages.TRY_SPAWN_BALLS, { count = count })
end

local function add_ball(self)
	msg.post(game_messages.GAME_CONTROLLER, game_messages.ADD_BALL)
end

local function reset_game(self)
	msg.post(game_messages.GAME_CONTROLLER, game_messages.RESET_GAME)
end

local function setup_button_texture(button)
	local function show_normal_texture()
		gui.play_flipbook(button.node, BUTTON_NORMAL)
	end

	button.on_pressed:subscribe(function()
		gui.play_flipbook(button.node, BUTTON_PUSH)
	end)
	button.on_click:subscribe(show_normal_texture)
	button.on_click_outside:subscribe(show_normal_texture)
end

function init(self)
	self.druid = druid.new(self)

	self.button_x1 = self.druid:new_button("button_x1", try_spawn_balls, 1)
	self.button_xn = self.druid:new_button("button_xn", try_spawn_balls, config.params.multiple_balls_count)
	self.button_test_add = self.druid:new_button("button_test_add", add_ball)
	self.button_test_reset = self.druid:new_button("button_test_reset", reset_game)
	setup_button_texture(self.button_x1)
	setup_button_texture(self.button_xn)
	setup_button_texture(self.button_test_add)
	setup_button_texture(self.button_test_reset)

	self.button_x1_text = self.druid:new_text("text", nil, "no_adjust")
	self.button_xn_text = self.druid:new_text("text1", "x" .. config.params.multiple_balls_count, "no_adjust")
	self.balls_label_text = self.druid:new_text("balls", nil, "no_adjust")
	self.balls_count_text = self.druid:new_text("vlaue", config.params.balls_count, "no_adjust")
	self.timer_text = self.druid:new_text("timer", nil, "no_adjust")
	self.button_test_add_text = self.druid:new_text("text2", nil, "no_adjust")
	self.button_test_reset_text = self.druid:new_text("text3", nil, "no_adjust")

	msg.post(game_messages.GAME_CONTROLLER, game_messages.SUBSCRIBE_GAME_STATE)
end

function update(self, dt)
	self.druid:update(dt)
end

function final(self)
	msg.post(game_messages.GAME_CONTROLLER, game_messages.UNSUBSCRIBE_GAME_STATE)
	self.druid:final()
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end

function on_message(self, message_id, message, sender)
	if message_id == game_messages.GAME_STATE_CHANGED then
		update_status(self, message)
	end
	self.druid:on_message(message_id, message, sender)
end
