local game_messages = require "scripts.game_messages"
local slot_layout = require "scripts.slot_layout"

local function initialize_target_weights(self)
	self.target_weights = {}
	self.total_target_weight = 0
	for slot_index = 1, slot_layout.get_slot_count() do
		local weight = slot_layout.get_slot_tier(slot_index).weight
		self.target_weights[slot_index] = weight
		self.total_target_weight = self.total_target_weight + weight
	end
end

local function select_target_slot(self)
	local random_weight = math.random() * self.total_target_weight
	for slot_index = 1, #self.target_weights do
		random_weight = random_weight - self.target_weights[slot_index]
		if random_weight <= 0 then
			return slot_index
		end
	end
	return #self.target_weights
end

local function create_path(target_slot)
	local row_count = slot_layout.get_peg_row_count()
	local right_count = target_slot - 1
	local directions = {}

	for row = 1, row_count do
		directions[row] = row <= right_count
	end

	-- Shuffle the required number of left/right decisions. Every ordering is a
	-- valid route, while the number of right turns fixes the final slot exactly.
	for row = row_count, 2, -1 do
		local other_row = math.random(row)
		directions[row], directions[other_row] = directions[other_row], directions[row]
	end

	local path_bits = 0
	local path_debug = {}
	for row = 1, row_count do
		if directions[row] then
			path_bits = path_bits + 2 ^ (row - 1)
			path_debug[row] = "R"
		else
			path_debug[row] = "L"
		end
	end

	return path_bits, table.concat(path_debug)
end

local function create_ball(self)
	local target_slot = select_target_slot(self)
	local path_bits, path_debug = create_path(target_slot)
	factory.create("#ball_factory", go.get_world_position(), nil, {
		path_bits = path_bits,
	})
	print(string.format("Spawned ball target slot: %d, path: %s", target_slot, path_debug))
end

function init(self)
	initialize_target_weights(self)
end

function on_message(self, message_id, message, sender)
	if message_id == game_messages.SPAWN_BALLS then
		local count = math.max(1, math.floor(message.count or 1))
		for _ = 1, count do
			create_ball(self)
		end
	end
end
