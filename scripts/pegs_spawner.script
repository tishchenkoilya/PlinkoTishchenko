local board_registry = require "scripts.board_registry"
local config = require "scripts.config"
local slot_layout = require "scripts.slot_layout"

local function create_peg_triangle(self)
	local origin = go.get_world_position()
	local row_count = slot_layout.get_peg_row_count()
	local horizontal_spacing = slot_layout.get_peg_horizontal_spacing()
	local triangle_height = (row_count - 1) * horizontal_spacing
	local top_y = origin.y + config.params.offset_y + triangle_height * 0.5

	for row = 1, row_count do
		local y = top_y - (row - 1) * horizontal_spacing
		local first_x = origin.x - (row - 1) * horizontal_spacing * 0.5

		for column = 1, row do
			local x = first_x + (column - 1) * horizontal_spacing
			local peg_id = factory.create("#peg_factory", vmath.vector3(x, y, origin.z))
			board_registry.register_peg(peg_id, row)
		end
	end
end

function init(self)
	create_peg_triangle(self)
end
