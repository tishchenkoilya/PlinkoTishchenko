local board_registry = require "scripts.board_registry"
local config = require "scripts.config"
local game_messages = require "scripts.game_messages"
local slot_layout = require "scripts.slot_layout"

local PEGS_SPAWNER = "/pegs_spawner"
local DEBUG = "/debug#script"
local SLOT_SPRITE_WIDTH = 32

local function get_slot_color(slot_index)
	return slot_layout.get_slot_tier(slot_index).color
end

local function create_slots(self)
	local origin = go.get_world_position()
	local pegs_origin = go.get_world_position(PEGS_SPAWNER)
	local slot_count = slot_layout.get_slot_count()
	local slot_width = slot_layout.get_slot_width()
	local peg_row_count = slot_layout.get_peg_row_count()
	local triangle_height = (peg_row_count - 1) * slot_layout.get_peg_horizontal_spacing()
	local bottom_peg_y = pegs_origin.y + config.params.offset_y - triangle_height * 0.5
	local y = bottom_peg_y - config.params.slot_offset_from_pegs
	local slot_scale = slot_width / SLOT_SPRITE_WIDTH

	for slot_index = 1, slot_count do
		local x = slot_layout.get_slot_x(origin.x, slot_index)
		local position = vmath.vector3(x, y, origin.z)
		local slot_id = factory.create("#slot_factory", position, nil, nil, slot_scale)
		board_registry.register_slot(slot_id, slot_index)
		local sprite_url = msg.url(nil, slot_id, "sprite")
		go.set(sprite_url, "tint", get_slot_color(slot_index))
		msg.post(DEBUG, game_messages.REGISTER_SLOT, {
			slot_id = slot_id,
			slot_index = slot_index,
		})

		if slot_index == 1 then
			local left_separator_x = x - slot_width * 0.5
			factory.create("#separator_factory", vmath.vector3(left_separator_x, y, origin.z), nil, nil, slot_scale)
		end

		local right_separator_x = x + slot_width * 0.5
		factory.create("#separator_factory", vmath.vector3(right_separator_x, y, origin.z), nil, nil, slot_scale)
	end
end

function init(self)
	create_slots(self)
end
